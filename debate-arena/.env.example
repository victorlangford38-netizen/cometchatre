# Server only. Never prefix private credentials with VITE_.
COMETCHAT_APP_ID=
COMETCHAT_REGION=us
COMETCHAT_REST_API_KEY=

# Required on Vercel: persistent Upstash Redis (Vercel Marketplace works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: without an LLM key the game uses a labeled heuristic judge.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
GAME_PACE=normal
